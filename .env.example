# 阿里云 DashScope 配置（主 API）
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# 备用 OpenAI 兼容 API 配置（可选，用于主 API 失败时回退）
# 注意：备用模型必须支持 OpenAI 兼容的 function calling（agent 路径依赖）
# FALLBACK_API_KEY=
# FALLBACK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# FALLBACK_MODEL=deepseek-v3-250324

# 数据库配置
DATABASE_URL=sqlite:///data/health_assistant.db

# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
